# =============================================================================
# ZAYNB — configuration du serveur local (accès AnyDesk)
# Copier en Backend/.env :  cp Backend/.env.local.example Backend/.env
# (scripts/start.sh le fait automatiquement au premier lancement)
# Ne jamais commiter Backend/.env.
# =============================================================================

# --- Données ------------------------------------------------------------------
# Racine unique (disque rapide, ≥ 200 Go libres, ≥ 1 To recommandé) :
#   reference/hg38/        FASTA, index, known-sites BQSR (GATK Resource Bundle — public)
#   reference/clinvar/     ClinVar GRCh38 (NCBI — domaine public)
#   reference/panels/      BED du panel (généré automatiquement)
#   patients/<ID>/input/   FASTQ R1/R2, VCF
#   patients/<ID>/output/  BAM, VCF, artefacts JSON, rapports
#   models/                cache HuggingFace (BioGPT), Ollama, données d'entraînement
#   tmp/                   travail, cache des résultats, état des jobs
LOCAL_DATA_ROOT=/data/zaynb

# --- Réseau / sécurité --------------------------------------------------------
# 127.0.0.1 = interface accessible UNIQUEMENT depuis le serveur (navigateur via AnyDesk).
# Pour d'autres postes du réseau local : IP LAN du serveur (ex. 192.168.1.50)
# et ajouter http://<IP>:3000 à CORS_ORIGINS. Ne jamais ouvrir ces ports sur Internet.
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
BACKEND_PORT=8000
# Utile seulement si un navigateur appelle directement le port 8000 (le frontend relaie /api/v1).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Appel de variants (FASTQ → VCF) ------------------------------------------
# auto : Parabricks si un GPU a ≥ PARABRICKS_MIN_VRAM_GB, sinon GATK4 sur CPU
# parabricks | cpu : forcer un moteur
PIPELINE_BACKEND=auto
PARABRICKS_MIN_VRAM_GB=16
PARABRICKS_IMAGE=nvcr.io/nvidia/clara/clara-parabricks:4.6.0-1
# Mémoire max du conteneur Parabricks (≈ RAM du serveur − 8 Go)
PARABRICKS_MEMORY_GB=48
PARABRICKS_SHM_SIZE=8g
# GPU 16 Go : passer à true si fq2bam échoue par manque de mémoire GPU
PARABRICKS_LOW_MEMORY=false
GATK_DOCKER_IMAGE=broadinstitute/gatk:4.2.6.1
GATK_MARK_DUPLICATES=true
GATK_BQSR=true
# Threads BWA (défaut : tous les cœurs)
# PIPELINE_THREADS=16
# Marge (pb) autour des gènes du panel pour HaplotypeCaller et la lecture des VCF
PANEL_INTERVAL_PADDING=100
# Chemins par défaut (créés par scripts/download_reference.sh) — décommenter pour surcharger
# REFERENCE_GENOME=/data/zaynb/reference/hg38/hg38.fa
# KNOWN_SITES_VCF=/data/zaynb/reference/hg38/Homo_sapiens_assembly38.known_indels.vcf.gz
# MILLS_INDELS_VCF=/data/zaynb/reference/hg38/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz
# DBSNP_VCF=/data/zaynb/reference/hg38/Homo_sapiens_assembly38.dbsnp138.vcf
# CLINVAR_VCF=/data/zaynb/reference/clinvar/clinvar_GRCh38.vcf.gz

# --- Interprétation clinique (règles déterministes zaynb-rules-v1) ------------
# Un variant pathogène sous ces seuils est rapporté « à confirmer » (risque INDÉTERMINÉ).
CLINICAL_MIN_QUAL=30
CLINICAL_MIN_DP=15
CLINICAL_HET_VAF_MIN=0.25
CLINICAL_HET_VAF_MAX=0.75
CLINICAL_HOM_VAF_MIN=0.85

# --- BioGPT (commentaire bibliographique, jamais décisionnel) ----------------
BIOGPT_COMMENTARY=true
PREDICTION_MODEL=microsoft/biogpt
# auto : CUDA si disponible, sinon CPU
LLM_DEVICE=auto
# Adaptateur LoRA BioGPT optionnel
# BIOGPT_ADAPTER_PATH=/data/zaynb/models/biogpt-genomic-ft

# --- Orchestrateur multi-agent ------------------------------------------------
# true : ordre du registre ; false : Mistral (Ollama) choisit parmi les étapes prêtes
# (le résultat clinique est identique dans les deux cas).
ORCHESTRATOR_DETERMINISTIC=true
ORCHESTRATOR_LLM_MODEL=mistral:v0.3
OLLAMA_KEEP_ALIVE=0
ORCHESTRATOR_TEMPERATURE=0.1
ORCHESTRATOR_NUM_CTX=4096
# VRAM au-delà de laquelle Mistral et BioGPT restent chargés ensemble
GPU_SHARED_VRAM_GB=24
# Réutilise l'appel de variants si les FASTQ et la configuration n'ont pas changé
ZAYNB_CACHE=true

# --- Divers -------------------------------------------------------------------
LOG_LEVEL=INFO
# LOG_FILE_PATH=/data/zaynb/tmp/logs/backend.log
# Image Ollama (épingler une version pour la reproductibilité, ex. ollama/ollama:0.6.8)
OLLAMA_IMAGE=ollama/ollama:latest
