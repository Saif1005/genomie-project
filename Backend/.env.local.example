# =============================================================================
# GermlineIQ — local server configuration (remote access via AnyDesk)
# Copy to Backend/.env:  cp Backend/.env.local.example Backend/.env
# (scripts/start.sh does it automatically on first start)
# Never commit Backend/.env.
# =============================================================================

# --- Data ---------------------------------------------------------------------
# Single root (fast disk, ≥ 200 GB free, ≥ 1 TB recommended):
#   reference/hg38/        FASTA, indexes, BQSR known sites (GATK Resource Bundle — public)
#   reference/clinvar/     ClinVar GRCh38 (NCBI — public domain)
#   reference/panels/      panel BED (generated automatically)
#   patients/<ID>/input/   FASTQ R1/R2, VCF
#   patients/<ID>/output/  BAM, VCF, JSON artifacts, reports
#   models/                HuggingFace cache (BioGPT), Ollama, training data, LoRA adapters
#   benchmarks/            latest multi-agent benchmark results
#   tmp/                   work files, result cache, job state
LOCAL_DATA_ROOT=/data/germlineiq

# --- Network / security -------------------------------------------------------
# 127.0.0.1 = interface reachable ONLY from the server (browser through AnyDesk).
# For other machines on the local network: server LAN IP (e.g. 192.168.1.50)
# and add http://<IP>:3000 to CORS_ORIGINS. Never open these ports to the Internet.
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
BACKEND_PORT=8000
# Only useful if a browser calls port 8000 directly (the frontend proxies /api/v1).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Variant calling (FASTQ → VCF) --------------------------------------------
# auto: Parabricks if a GPU has ≥ PARABRICKS_MIN_VRAM_GB, otherwise GATK4 on CPU
# parabricks | cpu: force an engine
PIPELINE_BACKEND=auto
PARABRICKS_MIN_VRAM_GB=16
PARABRICKS_IMAGE=nvcr.io/nvidia/clara/clara-parabricks:4.6.0-1
# Maximum memory of the Parabricks container (≈ server RAM − 8 GB)
PARABRICKS_MEMORY_GB=48
PARABRICKS_SHM_SIZE=8g
# 16 GB GPU: set to true if fq2bam runs out of GPU memory
PARABRICKS_LOW_MEMORY=false
GATK_DOCKER_IMAGE=broadinstitute/gatk:4.2.6.1
# User of the GATK/Parabricks containers: auto = uid:gid of the backend (outputs owned by the
# service account, never by root); root = Docker default; or an explicit "uid:gid".
# Docker Compose deployment (backend runs as root in its container): set the host user, e.g. 1000:1000.
CONTAINER_USER=auto
GATK_MARK_DUPLICATES=true
GATK_BQSR=true
# BWA threads (default: all cores)
# PIPELINE_THREADS=16
# Padding (bp) around the panel genes for HaplotypeCaller and VCF reading
PANEL_INTERVAL_PADDING=100
# Default paths (created by scripts/download_reference.sh) — uncomment to override
# REFERENCE_GENOME=/data/germlineiq/reference/hg38/hg38.fa
# KNOWN_SITES_VCF=/data/germlineiq/reference/hg38/Homo_sapiens_assembly38.known_indels.vcf.gz
# MILLS_INDELS_VCF=/data/germlineiq/reference/hg38/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz
# DBSNP_VCF=/data/germlineiq/reference/hg38/Homo_sapiens_assembly38.dbsnp138.vcf
# CLINVAR_VCF=/data/germlineiq/reference/clinvar/clinvar_GRCh38.vcf.gz

# --- Clinical interpretation (deterministic rules germlineiq-rules-v1.1) ------
# A pathogenic variant below these thresholds is reported "to confirm" (INDETERMINATE risk).
# CLINICAL_MIN_DP is also the depth used for the coverage of known pathogenic sites.
CLINICAL_MIN_QUAL=30
CLINICAL_MIN_DP=15
CLINICAL_HET_VAF_MIN=0.25
CLINICAL_HET_VAF_MAX=0.75
CLINICAL_HOM_VAF_MIN=0.85

# --- BioGPT (literature commentary, never used for decisions; every sentence verified) ---
BIOGPT_COMMENTARY=true
PREDICTION_MODEL=microsoft/biogpt
# auto: CUDA if available, otherwise CPU
LLM_DEVICE=auto
# Optional BioGPT LoRA adapter (only if its evaluation passed: python -m src.llm.finetune evaluate)
# BIOGPT_ADAPTER_PATH=/data/germlineiq/models/biogpt-germlineiq-lora/adapter
# Interpretation of the VCF statistics by BioGPT fine-tuned on statistics (python -m src.llm.stats_finetune all).
# Default adapter: models/biogpt-germlineiq-stats/promoted/adapter (only present if the evaluation gate
# passed); without it, the deterministic reference text is used. Every sentence is verified either way.
BIOGPT_STATS_INTERPRETATION=true
# BIOGPT_STATS_ADAPTER_PATH=/data/germlineiq/models/biogpt-germlineiq-stats/promoted/adapter

# --- Multi-agent orchestrator -------------------------------------------------
# true: registry order; false: Mistral (Ollama) picks among the ready steps
# (the clinical result is identical in both cases — see the orchestration benchmark).
ORCHESTRATOR_DETERMINISTIC=true
ORCHESTRATOR_LLM_MODEL=mistral:v0.3
OLLAMA_KEEP_ALIVE=0
ORCHESTRATOR_TEMPERATURE=0.1
ORCHESTRATOR_NUM_CTX=4096
# VRAM above which Mistral and BioGPT stay loaded together
GPU_SHARED_VRAM_GB=24
# Reuse variant calling if the FASTQ files and the configuration have not changed
GERMLINEIQ_CACHE=true

# --- Miscellaneous ------------------------------------------------------------
LOG_LEVEL=INFO
# LOG_FILE_PATH=/data/germlineiq/tmp/logs/backend.log
# Ollama image (pin a version for reproducibility, e.g. ollama/ollama:0.6.8)
OLLAMA_IMAGE=ollama/ollama:latest
