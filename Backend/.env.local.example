# =============================================================================
# ZAYNB — configuration SERVEUR LOCAL (on-premise, accès AnyDesk)
# Copier en Backend/.env :  cp Backend/.env.local.example Backend/.env
# (scripts/start.sh le fait automatiquement au premier lancement)
# Ne jamais commiter Backend/.env. Aucune variable AWS n'est nécessaire.
# =============================================================================

# --- Mode de déploiement ------------------------------------------------------
# local : fichiers sur le disque du serveur, aucun appel AWS
# aws   : comportement historique (S3 + EC2) — voir Backend/.env.example
DEPLOYMENT_MODE=local

# Racine des données (référence hg38, patients, modèles, fichiers temporaires).
# Doit être sur un disque rapide avec ≥ 200 Go libres (≥ 1 To recommandé).
#   reference/hg38/        FASTA, .fai, .dict, index BWA, known-sites BQSR
#   patients/<ID>/input/   FASTQ R1/R2, VCF
#   patients/<ID>/output/  BAM, VCF, rapports JSON
#   models/                cache HuggingFace (BioGPT) + modèles Ollama
#   tmp/                   travail / scratch
LOCAL_DATA_ROOT=/data/zaynb

# --- Réseau / sécurité --------------------------------------------------------
# 127.0.0.1 = interface accessible UNIQUEMENT depuis le serveur (navigateur via AnyDesk).
# Pour d'autres postes du réseau local : mettre l'IP LAN du serveur (ex. 192.168.1.50)
# et ajouter http://<IP>:3000 à CORS_ORIGINS. Ne jamais ouvrir ces ports sur Internet.
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
BACKEND_PORT=8000
# Utile seulement si un navigateur appelle directement le port 8000 (le frontend passe par
# son proxy interne, donc pas de CORS en usage normal).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Pipeline génomique -------------------------------------------------------
# auto       : Parabricks si un GPU a ≥ PARABRICKS_MIN_VRAM_GB, sinon GATK4 CPU
# parabricks : forcer le GPU        cpu : forcer GATK4 CPU (BWA-MEM + conteneur GATK)
PIPELINE_BACKEND=auto
PARABRICKS_MIN_VRAM_GB=16
PARABRICKS_IMAGE=nvcr.io/nvidia/clara/clara-parabricks:4.6.0-1
PARABRICKS_GPU_COUNT=1
# Mémoire max du conteneur Parabricks — à ajuster à la RAM du serveur (≈ RAM - 8 Go)
PARABRICKS_MEMORY_GB=48
PARABRICKS_SHM_SIZE=8g

GATK_DOCKER_IMAGE=broadinstitute/gatk:4.2.6.1
GATK_MARK_DUPLICATES=true
GATK_BQSR=true
# Chemins par défaut (créés par scripts/download_reference.sh) — décommenter pour surcharger
# REFERENCE_GENOME=/data/zaynb/reference/hg38/hg38.fa
# KNOWN_SITES_VCF=/data/zaynb/reference/hg38/Homo_sapiens_assembly38.known_indels.vcf.gz
# MILLS_INDELS_VCF=/data/zaynb/reference/hg38/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz

# --- Orchestrateur (Mistral via Ollama) --------------------------------------
# OLLAMA_HOST est forcé à http://ollama:11434 par docker-compose.local.yml
ORCHESTRATOR_LLM_MODEL=mistral:v0.3
OLLAMA_KEEP_ALIVE=0
ORCHESTRATOR_TEMPERATURE=0.1
ORCHESTRATOR_NUM_CTX=4096
ORCHESTRATOR_MODE=langgraph
USE_ORCHESTRATOR=true
ORCHESTRATOR_DETERMINISTIC=true
USE_LANGGRAPH=true
MCP_TOOLS_ENABLED=true
# false : démarre même sans GPU (BioGPT bascule sur CPU)
REQUIRE_CUDA=false
# VRAM au-delà de laquelle Mistral et BioGPT restent chargés ensemble
GPU_SHARED_VRAM_GB=24

# --- BioGPT (inférence clinique) ---------------------------------------------
BIOLLM_MODEL=biogpt
PREDICTION_MODEL=microsoft/biogpt
# auto : CUDA si disponible, sinon CPU
LLM_DEVICE=auto
LLM_MODEL_PATH=/data/zaynb/models/biogpt-genomic-ft
SKIP_BIOGPT=false
ALLOW_RULE_BASED_FALLBACK=false
LLM_BACKEND=ollama

# --- Rapports -----------------------------------------------------------------
# Copie de travail ; la version finale est rangée dans patients/<ID>/output/
REPORT_OUTPUT_DIR=/data/zaynb/tmp/reports
REPORT_FORMAT=json

# --- Divers -------------------------------------------------------------------
RUN_ON_EC2=false
# Image Ollama (épingler une version pour la reproductibilité, ex. ollama/ollama:0.6.8)
OLLAMA_IMAGE=ollama/ollama:latest
